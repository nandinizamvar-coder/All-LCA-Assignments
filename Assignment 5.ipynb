   "source": [
    "# Assignment 5: PAN Number Validation using Regular Expression "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "4fb32711-9e09-4b23-9153-993bce6e7e7d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter your PAN number:  AFPNZ4042F\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Valid PAN Numner\n"
     ]
    }
   ],
   "source": [
    "import re\n",
    "\n",
    "pan_number = input(\"Enter your PAN number: \")\n",
    "\n",
    "pattern = r\"^[A-Z]{5}[0-9]{4}[A-Z]$\"\n",
    "\n",
    "if re.fullmatch(pattern, pan_number):\n",
    "    print(\"Valid PAN Numner\")\n",
    "else:\n",
    "    print(\"Invalid PAN Number\")"
   ]
  },
